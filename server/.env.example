PORT=5000
MONGO_URI=mongodb://localhost:27017/chatapp

# Redis cho rate-limit tập trung (server/src/utils/rateLimiter.js) — để trống thì tự rơi về
# in-memory (chỉ đúng khi chạy 1 instance). Chỉ cần set khi scale ngang nhiều instance.
REDIS_URL=
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Xoay vòng JWT secret (tùy chọn) — không set thì tự dùng JWT_SECRET làm keyring 1 phần tử.
# Định dạng JWT_SECRETS: "kid1:secret1,kid2:secret2". JWT_SECRET_CURRENT_KID chọn secret dùng để
# KÝ token mới — mọi secret trong JWT_SECRETS vẫn dùng để XÁC THỰC token cũ cho tới khi tự hết hạn.
# Khi rotate: thêm 1 cặp kid:secret mới vào JWT_SECRETS, đổi JWT_SECRET_CURRENT_KID sang kid đó,
# giữ nguyên secret cũ trong danh sách ít nhất 7 ngày (hạn dài nhất của token thiết bị) rồi mới xóa.
JWT_SECRETS=
JWT_SECRET_CURRENT_KID=

# Số hop reverse proxy thật trước server (Cloudflare, Nginx...) — 0 = tắt (mặc định, an toàn cho
# dev local). Chỉ đặt >0 sau khi đã xác nhận proxy đó đang thật sự chạy, nếu không sẽ mở đường
# giả mạo IP qua header X-Forwarded-For, phá vỡ rate-limit theo IP.
TRUST_PROXY_HOPS=0

# Cloudflare Turnstile (CAPTCHA) cho form đăng ký/quên mật khẩu — để trống thì bỏ qua verify (dev local)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Email service (Brevo/Sendinblue or any SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_sender_email@domain.com

# Cloudinary credentials for media upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cryptography & AI Moderation (Option 1)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
OPENAI_API_KEY=your_optional_openai_api_key_here

# Google Safe Browsing — kiểm tra link người dùng gửi có an toàn không (server/src/routes/security.js)
# để trống thì coi mọi link là an toàn (bỏ qua kiểm tra)
SAFE_BROWSING_API_KEY=

